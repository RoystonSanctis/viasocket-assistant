{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/RoystonSanctis/viasocket-assistant/config-stable/schemas/tools.schema.json",
  "title": "Tool switches",
  "description": "Turn individual agent tools off, or override the description the AI sees. Tools themselves are implemented in the extension; unknown names are ignored.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tools"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "tools": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "description": "Replaces the description compiled into the extension. Leave it out to use the built-in wording."
          },
          "enabled": { "type": "boolean" }
        }
      }
    }
  }
}
